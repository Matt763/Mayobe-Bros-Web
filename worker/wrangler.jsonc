{
  // Mayobe Bros comments + reactions API (Cloudflare Worker + D1)
  "name": "mayobe-engage",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "vars": {
    "ALLOWED_ORIGINS": "https://mayobebros.com,https://www.mayobebros.com",
    "SITE_ORIGIN": "https://mayobebros.com",
    "MAIL_FROM": "Mayobe Bros <info@mayobebros.com>",
    "MAIL_FROM_SUPPORT": "Mayobe Bros <support@mayobebros.com>",
    "OWNER_EMAIL": "info@mayobebros.com",
    "CONTACT_EMAIL": "info@mayobebros.com",
    // Newsletter: new-article emails go out only when this is exactly "true". Seeding and the daily clean-up run either way.
    "NEWSLETTER_SEND": "false",
    // This Worker's own https origin, used only in the List-Unsubscribe header (one-click POST). Missing or not https: no article emails.
    "API_ORIGIN": "https://mayobe-engage.mattmclean763.workers.dev"
  },
  // Daily newsletter run (runNewsletter) at 04:00 UTC, 07:00 in Tanzania.
  "triggers": { "crons": ["0 4 * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mayobe-engage",
      "database_id": "cacaf5f7-0c3c-4904-9a32-f8b857956bb2",
      "migrations_dir": "migrations"
    }
  ]
  // Secrets (never put these in this file; set them with `wrangler secret put`):
  //   ADMIN_TOKEN       long random string used by scripts/comments.mjs to moderate
  //   HASH_SALT         any long random string (used to hash visitor IPs, rotates daily)
  //   TURNSTILE_SECRET  optional, only if you turn on Cloudflare Turnstile
  //   RESEND_API_KEY        Resend API key (sending only); without it email is switched off
  //   RESEND_WEBHOOK_SECRET Resend webhook signing secret (whsec_...); without it the webhook refuses everything
}
