# Copy to worker/.dev.vars (git-ignored) and fill in YOUR values. Names only here: never put real values in this file.
ADMIN_TOKEN=
HASH_SALT=
# Leave RESEND_API_KEY empty for local runs: a real key would send real mail and collide with production idempotency keys.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
TURNSTILE_SECRET=
